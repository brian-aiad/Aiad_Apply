DATABASE_URL=postgresql://pooled-application-connection
DIRECT_URL=postgresql://direct-migration-connection
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-key
SUPABASE_SERVICE_ROLE_KEY=server-only-key
WORKER_SECRET=long-random-server-to-worker-secret
# Stale RUNNING jobs are safely requeued after this lease (minimum 600 seconds).
WORKER_LEASE_SECONDS=1800
AIADAPPLY_TRACKING_URL=http://127.0.0.1:3000
# Stable defaults chosen for high-quality tailoring with restrained Codex usage.
AIADAPPLY_CODEX_MODEL=gpt-5.6-sol
AIADAPPLY_CODEX_REASONING_EFFORT=low
AIADAPPLY_OUTPUT_ROOT=~/Library/CloudStorage/OneDrive-Personal/Downloads/Resume_Builder/OUTPUT_RESUMES
# Optional. Defaults beside OUTPUT_RESUMES as Resume_Builder/USED_RESUME.
AIADAPPLY_USED_RESUME_ROOT=~/Library/CloudStorage/OneDrive-Personal/Downloads/Resume_Builder/USED_RESUME
AIADAPPLY_USERNAME=brian
AIADAPPLY_PASSWORD=long-random-dashboard-password
# Required only for Playwright; must point to an isolated disposable database/schema.
AIADAPPLY_E2E_DATABASE_URL=postgresql://e2e-only-connection

# Optional base document override (otherwise prefers the base beside output folders).
AIADAPPLY_BASE_RESUME=~/Library/CloudStorage/OneDrive-Personal/Downloads/Resume_Builder/Brian_Aiad_BASE.docx
